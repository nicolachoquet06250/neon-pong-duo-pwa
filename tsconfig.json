{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true, "allowSyntheticDefaultImports": true, "types": ["vite/client", "vitest/globals"],
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "tests", "vite.config.ts"]
}
