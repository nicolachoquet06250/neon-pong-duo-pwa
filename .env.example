# npm run dev uses HTTPS + WSS automatically. The self-signed certificate is
# generated once under .cert/ (ignored by Git). Node.js 22+ required.
# IPs des interfaces LAN incluses automatiquement dans le certificat dev.
# Optional: additional local DNS names / IPs for certificate SANs.
# DEV_TLS_HOSTS=my-laptop.local
# Optional: provide a trusted mkcert certificate/key instead.
# DEV_TLS_CERT=.cert/dev-cert.pem
# DEV_TLS_KEY=.cert/dev-key.pem
# Optional: change the generated certificate directory (used by integration tests).
# DEV_TLS_DIR=.cert

# Serveur dev accessible sur toutes les interfaces par défaut ; port TCP 3000.
# Note : ce fichier .env.example est une référence, il n’est pas chargé automatiquement.
PORT=3000
HOST=0.0.0.0
# Optional TURN for connections behind restrictive NATs:
# TURN_URLS=turn:turn.example.org:3478,turns:turn.example.org:5349
# TURN_USERNAME=username
# TURN_CREDENTIAL=password
